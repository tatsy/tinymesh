{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/build/install/${presetName}",
      "cacheVariables": {
        "TINYMESH_WITH_OPENMP": "ON",
        "TINYMESH_BUILD_TESTS": "ON",
        "TINYMESH_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "msvc2026",
      "displayName": "MSVC 2026",
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "TINYMESH_WITH_OPENMP": "ON"
      }
    },
    {
      "name": "gcc",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "clang",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "build-release",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "build-debug",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ninja-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja"
    },
    {
      "name": "macos-ninja",
      "hidden": true,
      "inherits": ["ninja-base", "clang"],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-release",
      "displayName": "macOS Release",
      "inherits": ["macos-ninja", "build-release"],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-debug",
      "displayName": "macOS Debug",
      "inherits": ["macos-ninja", "build-debug"],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "linux-ninja",
      "hidden": true,
      "inherits": ["ninja-base", "gcc"],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "inherits": ["linux-ninja", "build-release"],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "inherits": ["linux-ninja", "build-debug"],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-base",
      "hidden": true,
      "jobs": 4
    },
    {
      "name": "build-macos",
      "hidden": true,
      "inherits": "build-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-debug",
      "inherits": "build-macos",
      "configurePreset": "macos-debug",
      "configuration": "Debug"
    },
    {
      "name": "macos-release",
      "inherits": "build-macos",
      "configurePreset": "macos-release",
      "configuration": "Release"
    },
    {
      "name": "build-windows",
      "hidden": true,
      "inherits": "build-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "Debug",
      "inherits": "build-windows",
      "configurePreset": "msvc2026",
      "configuration": "Debug"
    },
    {
      "name": "Release",
      "inherits": "build-windows",
      "configurePreset": "msvc2026",
      "configuration": "Release"
    },
    {
      "name": "RelWithDebInfo",
      "inherits": "build-windows",
      "configurePreset": "msvc2026",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "MinSizeRel",
      "inherits": "build-windows",
      "configurePreset": "msvc2026",
      "configuration": "MinSizeRel"
    }
  ]
}
