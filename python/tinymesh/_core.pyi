from typing import ClassVar, SupportsInt, SupportsFloat, SupportsIndex, overload
from collections.abc import Sequence

import numpy as np
from numpy.typing import NDArray, ArrayLike
from scipy.sparse import spmatrix, csc_matrix

_IntLike = SupportsInt | SupportsIndex
_FloatLike = SupportsFloat | SupportsIndex
_FloatArray = NDArray[np.float64]

class Mesh:
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, filename: str, /) -> None: ...
    @overload
    def __init__(
        self,
        vertices: Sequence[ArrayLike] | NDArray[np.generic],
        indices: Sequence[_IntLike] | NDArray[np.integer],
        /,
    ) -> None: ...
    def clone(self) -> Mesh: ...
    def load(self, filename: str, /) -> None: ...
    def save(self, filename: str, /) -> None: ...
    def vertex(self, index: _IntLike, /) -> Vertex: ...
    def face(self, index: _IntLike, /) -> Face: ...
    def get_vertices(self) -> list[_FloatArray]: ...
    def get_vertex_indices(self) -> list[int]: ...
    def num_vertices(self) -> int: ...
    def num_edges(self) -> int: ...
    def num_halfedges(self) -> int: ...
    def num_faces(self) -> int: ...
    def fill_holes(self) -> None: ...
    def verify(self) -> bool: ...

class Vertex:
    def __init__(self) -> None: ...
    def pos(self) -> _FloatArray: ...
    def set_pos(self, pos: ArrayLike, /) -> None: ...
    def normal(self) -> _FloatArray: ...
    def K(self) -> float: ...  # noqa: N802
    def H(self) -> float: ...  # noqa: N802
    def is_boundary(self) -> bool: ...
    def is_locked(self) -> bool: ...
    def lock(self) -> None: ...
    def unlock(self) -> None: ...

class Face:
    def __init__(self) -> None: ...
    def area(self) -> float: ...
    def is_boundary(self) -> bool: ...
    def is_hole(self) -> bool: ...
    def is_locked(self) -> bool: ...

class MeshLaplace:
    ADJACENT: ClassVar[MeshLaplace]
    COTANGENT: ClassVar[MeshLaplace]
    BELKIN08: ClassVar[MeshLaplace]
    __members__: ClassVar[dict[str, MeshLaplace]]

    def __init__(self, value: _IntLike) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def value(self) -> int: ...
    def __int__(self) -> int: ...
    def __index__(self) -> int: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __ne__(self, other: object, /) -> bool: ...
    def __hash__(self) -> int: ...

def get_hausdorff_distance(mesh0: Mesh, mesh1: Mesh) -> float: ...
def get_per_vertex_shortest_distances(src: Mesh, dst: Mesh) -> _FloatArray: ...
def get_mesh_laplacian(mesh: Mesh, type: MeshLaplace) -> csc_matrix: ...
def get_heat_kernel_signatures(mesh: spmatrix, K: _IntLike = 300, n_times: _IntLike = 100) -> _FloatArray: ...  # noqa: N803
def get_principal_curvatures(
    mesh: Mesh, smooth_tensors: bool = False
) -> tuple[_FloatArray, _FloatArray, _FloatArray, _FloatArray]: ...
def get_principal_curvatures_with_derivatives(
    mesh: Mesh, smooth_tensors: bool = False
) -> tuple[_FloatArray, _FloatArray, _FloatArray, _FloatArray, _FloatArray, _FloatArray]: ...
def get_feature_line_field(mesh: Mesh, smooth_tensors: bool = False) -> _FloatArray: ...
def get_feature_line_field_with_flags(mesh: Mesh, smooth_tensors: bool = False) -> tuple[_FloatArray, _FloatArray]: ...
def smooth_laplacian(
    mesh: Mesh,
    epsilon: _FloatLike = 1.0,
    cotangent_weight: bool = False,
    iterations: _IntLike = 3,
) -> None: ...
def smooth_taubin(
    mesh: Mesh, shrink: _FloatLike = 0.5, inflate: _FloatLike = 0.53, iterations: _IntLike = 3
) -> None: ...
def implicit_fairing(mesh: Mesh, epsilon: _FloatLike = 1.0, iterations: _IntLike = 1) -> None: ...
def denoise_normal_gaussian(mesh: Mesh, sigma: _FloatLike = 0.2, iterations: _IntLike = 3) -> None: ...
def denoise_normal_bilateral(
    mesh: Mesh, sigma_c: _FloatLike = 0.2, sigma_s: _FloatLike = 0.1, iterations: _IntLike = 3
) -> None: ...
def denoise_l0_smooth(mesh: Mesh, alpha: _FloatLike = 0.1, beta: _FloatLike = 0.001) -> None: ...
def remesh_triangular(
    mesh: Mesh,
    short_length: _FloatLike = 0.8,
    long_length: _FloatLike = 1.333,
    angle_keep_less_than: _FloatLike = 0.0,
    iterations: _IntLike = 5,
    verbose: bool = False,
) -> None: ...
def simplify_qem(mesh: Mesh, n_triangles: _IntLike, n_trials: _IntLike = 10, verbose: bool = False) -> None: ...
def hole_fill_min_dihedral(mesh: Mesh, face: Face, dihedral_bound: _FloatLike = 3.141592653589793) -> None: ...
def hole_fill_advancing_front(mesh: Mesh, face: Face) -> None: ...
def hole_fill_context_coherent(mesh: Mesh, maxiters: _IntLike = 200) -> None: ...
